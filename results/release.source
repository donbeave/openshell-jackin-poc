878,"created_at":"2026-10-20T17:28:25Z","updated_at":"2026-10-20T17:28:31Z","browser_download_url":"https://github.com/NVIDIA/OpenShell/releases/download/v0.1.5/openshell_0.1.5-1_amd64.deb"},{"url":"https://api.github.com/repos/NVIDIA/OpenShell/releases/assets/659992880","id":659992880,"node_id":"RA_kwDORYG5fs4nVrEw","name":"openshell_0.1.5-1_arm64.deb","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-debian-package","state":"uploaded","size":76095322,"digest":"sha256:ae381703f78061141bbac44aa85fb7d9856cb567d2ab2b4306318365f5466ac5","download_count":140,"created_at":"2026-10-20T17:28:25Z","updated_at":"2026-10-20T17:28:31Z","browser_download_url":"https://github.com/NVIDIA/OpenShell/releases/download/v0.1.5/openshell_0.1.5-1_arm64.deb"},{"url":"https://api.github.com/repos/NVIDIA/OpenShell/releases/assets/659992879","id":659992879,"node_id":"RA_kwDORYG5fs4nVrEv","name":"openshell_0.1.5_amd64.snap","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":60850176,"digest":"sha256:c9bc86643faacfad82e3d6c5fcc17d3551c80fa0f9964458c90e07e55dc978dc","download_count":11,"created_at":"2026-10-20T17:28:25Z","updated_at":"2026-10-20T17:28:31Z","browser_download_url":"https://github.com/NVIDIA/OpenShell/releases/download/v0.1.5/openshell_0.1.5_amd64.snap"},{"url":"https://api.github.com/repos/NVIDIA/OpenShell/releases/assets/659992865","id":659992865,"node_id":"RA_kwDORYG5fs4nVrEh","name":"openshell_0.1.5_arm64.snap","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":54497280,"digest":"sha256:7f452483ff2b862e9117ef37dbd666f059ba652c62b02a6966bffab9fa3d01fa","download_count":10,"created_at":"2026-10-20T17:28:25Z","updated_at":"2026-10-20T17:28:31Z","browser_download_url":"https://github.com/NVIDIA/OpenShell/releases/download/v0.1.5/openshell_0.1.5_arm64.snap"}],"tarball_url":"https://api.github.com/repos/NVIDIA/OpenShell/tarball/v0.1.5","zipball_url":"https://api.github.com/repos/NVIDIA/OpenShell/zipball/v0.1.5","body":"## OpenShell v0.1.5\n\n### Quick install\n\n```bash\ncurl -LsSf https://raw.githubusercontent.com/NVIDIA/OpenShell/main/install.sh | OPENSHELL_VERSION=v0.1.5 sh\n```\n\n### Upgrade notes\n\n- Supervisor OCSF log files are now named `openshell-ocsf.YYYY-MM-DD.jsonl` instead of `.log`, so update any collector patterns from `openshell-ocsf.*.log` to `openshell-ocsf.*.jsonl`. Old `.log` files are not migrated and may be cleaned up, so collect any history you need before upgrading. [#4263](https://github.com/NVIDIA/OpenShell/pull/4263)\n- On Kubernetes, sandbox templates that set pod annotations or labels are now rejected unless an operator allowlists those keys with the new `allowed_pod_annotations` and `allowed_pod_labels` settings in `[openshell.drivers.kubernetes]`. This affects direct API or SDK callers that set `SandboxTemplate.labels` or `SandboxTemplate.annotations`, including recovery of timed-out sandboxes; the `openshell` CLI and `--label` metadata labels are unaffected. [#4497](https://github.com/NVIDIA/OpenShell/pull/4497)\n- The gateway now rejects annotation keys with the reserved `internal.openshell.ai/` prefix on `CreateSandbox` and `UpdateConfig`. [#4626](https://github.com/NVIDIA/OpenShell/pull/4626)\n- The Go SDK's `SandboxInterface.Create()` and `CreateFromTemplate()` now take functional options such as `WithLabels()`, `WithAnnotations()`, and `WithServiceExposures()` instead of a positional labels argument and the removed `CreateOptions` struct. Update call sites to the new options. [#3198](https://github.com/NVIDIA/OpenShell/pull/3198)\n- External compute drivers that provision `openshell-sandbox` must update their bootstrap descriptor from `outer_fence` to `provisioning_evidence`; drivers that use their own isolation backend are unaffected. This release also publishes the versioned Sandbox Protocol for independently implemented backends. [#3898](https://github.com/NVIDIA/OpenShell/pull/3898)\n- The snap no longer enables the user gateway service for every user; the install script enables it only for the user who ran it. After a direct snap install, or if an older snap revision enabled it globally, run `sudo systemctl disable --global snap.openshell.user-gateway.service` once and then `systemctl --user enable --now snap.openshell.user-gateway.service` from the single account that should run the gateway. [#4615](https://github.com/NVIDIA/OpenShell/pull/4615)\n\n### Bug fixes\n\n- Hostname-based network policy is now bound to supervisor-controlled DNS, while sandbox host aliases still require explicit IP validation or a trusted gateway pin. [#4602](https://github.com/NVIDIA/OpenShell/pull/4602)\n- Stopping a MicroVM sandbox no longer discards recent writes, because the guest now flushes its filesystem before shutdown. [#4195](https://github.com/NVIDIA/OpenShell/pull/4195)\n- You can now stop a sandbox stuck in `Error` after a startup failure and start it again, without deleting it or its persistent workspace. [#4231](https://github.com/NVIDIA/OpenShell/pull/4231)\n- OTLP export with gzip compression or an `https://` endpoint no longer fails at startup. [#4399](https://github.com/NVIDIA/OpenShell/pull/4399)\n- Podman deployments can trust a private CA for inspected HTTPS egress with the new `additional_ca_bundle` setting, without rebuilding the supervisor image. The CA is trusted for all destinations by both the supervisor and the workload. [#3996](https://github.com/NVIDIA/OpenShell/pull/3996)\n- The Helm chart now installs in namespaces that enforce the Restricted Pod Security standard, and the certgen hook security context can be overridden with `pkiInitJob.securityContext`. [#3340](https://github.com/NVIDIA/OpenShell/pull/3340)\n- GitHub App OAuth token refresh now works, because the gateway asks for a JSON response. [#4530](https://github.com/NVIDIA/OpenShell/pull/4530)\n- A deleted provider that sandboxes still reference no longer blocks gateway startup; the gateway logs a warning instead. [#4661](https://github.com/NVIDIA/OpenShell/pull/4661)\n- In Kubernetes operator workspace mode, labeled workspaces are no longer rejected with `PermissionDenied` right after gateway startup. [#4527](https://github.com/NVIDIA/OpenShell/pull/4527)\n- Kubernetes PVC mounts can no longer overlap driver-managed runtime and control paths. [#4522](https://github.com/NVIDIA/OpenShell/pull/4522)\n- The sandbox network broker now denies operations when it cannot verify a descriptor, instead of falling back to native handling. [#4494](https://github.com/NVIDIA/OpenShell/pull/4494)\n- VM guest startup is hardened so the packaged sandbox keeps its expected executable identity. [#4539](https://github.com/NVIDIA/OpenShell/pull/4539)\n- Seccomp notification probe failures now report the actual kernel error instead of a generic \"notification launcher disappeared\" message. [#4051](https://github.com/NVIDIA/OpenShell/pull/4051)\n- e2fsprogs preflight checks no longer fail when Linux briefly reports a newly installed executable as busy. [#4315](https://github.com/NVIDIA/OpenShell/pull/4315)\n- Middleware now sees `http` and `ws` for plaintext requests in a tunnel instead of `https` and `wss`. [#4397](https://github.com/NVIDIA/OpenShell/pull/4397)\n- L7 OCSF HTTP events now report `https` for TLS-terminated requests. [#4684](https://github.com/NVIDIA/OpenShell/pull/4684)\n- OCSF events now include the required `device.os.type_id`, so they validate against the OCSF 1.8 schema. [#4677](https://github.com/NVIDIA/OpenShell/pull/4677)\n- Mutation-lock metrics from the gateway's startup reconciliation are no longer dropped. [#4524](https://github.com/NVIDIA/OpenShell/pull/4524)\n- Updated `rustls` to 0.23.46 to address RUSTSEC-2026-0346 through RUSTSEC-2026-0349. [#4568](https://github.com/NVIDIA/OpenShell/pull/4568)\n- The RPM-installed Python SDK now imports correctly, and its stubs can be generated with older `protoc` versions. [#4439](https://github.com/NVIDIA/OpenShell/pull/4439)\n- Builds now honor the `PROTOC` environment variable, so distribution builds can use their system protobuf compiler. [#4441](https://github.com/NVIDIA/OpenShell/pull/4441)\n\n### Features\n\n- Supervisors can now receive configuration changes pushed over their gateway session by setting `config_delivery_mode = \"push\"`, so policy and setting changes reach sandboxes in about 100 ms instead of up to 10 seconds. Polling remains the default in this release. [#4320](https://github.com/NVIDIA/OpenShell/pull/4320)\n- The gateway and sandbox supervisors can export OCSF events as OTLP log records when `[openshell.gateway.otlp.ocsf]` sets `enabled = true`, and you can now send traces and OCSF events to different OTLP endpoints. Existing configurations with only `[openshell.gateway.otlp] endpoint` behave as before. [#4500](https://github.com/NVIDIA/OpenShell/pull/4500), [#4545](https://github.com/NVIDIA/OpenShell/pull/4545)\n- The gateway now emits OCSF Authentication events for rejected requests, including the authentication mechanism, a reason category, the peer address, and the request ID. [#4632](https://github.com/NVIDIA/OpenShell/pull/4632), [#4655](https://github.com/NVIDIA/OpenShell/pull/4655), [#4673](https://github.com/NVIDIA/OpenShell/pull/4673)\n- MicroVM sandboxes can mount host directories through virtiofs after an operator sets `enable_bind_mounts = true` in `[openshell.drivers.vm]`. You can use up to 3 mounts on x86_64 or 32 on aarch64, and QEMU-backed and GPU launches do not support mounts. [#3463](https://github.com/NVIDIA/OpenShell/pull/3463)\n- The Docker supervisor can now use bridge networking with the new `supervisor_network_mode` setting; host networking remains the default. [#4016](https://github.com/NVIDIA/OpenShell/pull/4016)\n- `openshell sandbox create` now accepts repeatable `--annotation KEY=VALUE` flags. [#4325](https://github.com/NVIDIA/OpenShell/pull/4325)\n- `openshell sandbox create` adds `--env-from KEY[=ENVVAR]` to set sandbox environment variables from the CLI's environment without putting values on the command line. The `OPENSHELL_OCSF_JSON=1` gateway audit sink is also now available on all platforms. [#4106](https://github.com/NVIDIA/OpenShell/pull/4106)\n- When a dynamic token grant is refused, sandbox reads now show a bounded cause and recovery action, while the workload gets an HTTP 502 with an `x-openshell-request-id` it can share. [#4427](https://github.com/NVIDIA/OpenShell/pull/4427)\n- The Helm chart adds `server.dataStorageSize` and `server.dataStorageClass` to configure the gateway data PVC. [#3854](https://github.com/NVIDIA/OpenShell/pull/3854)\n- Gateway mutation locks are now scoped per workspace and sandbox, with bounded waits, so bursts of supervisor reconnects no longer queue behind a single fleet-wide lock. [#4147](https://github.com/NVIDIA/OpenShell/pull/4147)\n\n### Other\n\n- Added documentation for the Port Forwarding IPv6 loopback example, `sandbox create` size limits, Kubernetes managed workspace setup, and new Observability overview and Traces pages. [#2449](https://github.com/NVIDIA/OpenShell/pull/2449), [#4447](https://github.com/NVIDIA/OpenShell/pull/4447), [#4622](https://github.com/NVIDIA/OpenShell/pull/4622), [#4560](https://github.com/NVIDIA/OpenShell/pull/4560)\n- Removed the grpcurl walkthrough from the README. [#4585](https://github.com/NVIDIA/OpenShell/pull/4585)\n- Added an RFC that proposes a sandbox service exposure architecture. [#4267](https://github.com/NVIDIA/OpenShell/pull/4267)\n- Introduced a backend-neutral cryptography interface while keeping AWS-LC as the production backend and preserving existing credential formats and TLS defaults. [#3351](https://github.com/NVIDIA/OpenShell/pull/3351)\n- The CLI and gateway no longer link `ring` alongside AWS-LC. [#4468](https://github.com/NVIDIA/OpenShell/pull/4468)\n- Sped up gateway server builds by removing `async_trait` from internal traits. [#4619](https://github.com/NVIDIA/OpenShell/pull/4619)\n- Updated development and build dependencies, including setuptools, pytest, TypeScript SDK test dependencies, and GitHub Actions, and temporarily accepted build-only `zip` advisories. [#4711](https://github.com/NVIDIA/OpenShell/pull/4711), [#4713](https://github.com/NVIDIA/OpenShell/pull/4713), [#4712](https://github.com/NVIDIA/OpenShell/pull/4712), [#4710](https://github.com/NVIDIA/OpenShell/pull/4710), [#2625](https://github.com/NVIDIA/OpenShell/pull/2625), [#3002](https://github.com/NVIDIA/OpenShell/pull/3002), [#4552](https://github.com/NVIDIA/OpenShell/pull/4552)\n- Reworked the release pipeline to separate prerelease publication from qualification, promote qualified prereleases to stable, generate PR-based release notes, retry Helm chart pushes, and improve Slack notifications. [#4419](https://github.com/NVIDIA/OpenShell/pull/4419), [#4420](https://github.com/NVIDIA/OpenShell/pull/4420), [#4611](https://github.com/NVIDIA/OpenShell/pull/4611), [#4654](https://github.com/NVIDIA/OpenShell/pull/4654), [#4747](https://github.com/NVIDIA/OpenShell/pull/4747), [#4578](https://github.com/NVIDIA/OpenShell/pull/4578), [#4605](https://github.com/NVIDIA/OpenShell/pull/4605), [#4719](https://github.com/NVIDIA/OpenShell/pull/4719)\n- Improved CI reliability and coverage, including restored default E2E coverage, Kubernetes conformance readiness, paginated required-gate lookups, Determinate Nix setup, and stricter compatibility-review risk acceptance. [#4424](https://github.com/NVIDIA/OpenShell/pull/4424), [#4676](https://github.com/NVIDIA/OpenShell/pull/4676), [#4663](https://github.com/NVIDIA/OpenShell/pull/4663), [#4593](https://github.com/NVIDIA/OpenShell/pull/4593), [#4601](https://github.com/NVIDIA/OpenShell/pull/4601), [#4595](https://github.com/NVIDIA/OpenShell/pull/4595)\n- Added and stabilized tests for OCI image identities, Landlock descriptor limits, CLI port forwarding, and Kubernetes 1.29 conformance. [#4521](https://github.com/NVIDIA/OpenShell/pull/4521), [#4457](https://github.com/NVIDIA/OpenShell/pull/4457), [#4570](https://github.com/NVIDIA/OpenShell/pull/4570), [#4463](https://github.com/NVIDIA/OpenShell/pull/4463)\n- tmachine can now build local Debian and RPM artifacts from a checkout. [#4598](https://github.com/NVIDIA/OpenShell/pull/4598), [#4651](https://github.com/NVIDIA/OpenShell/pull/4651)\n- Updated contributor tooling with triage duty workflows, explicit frozen labels for stale issues, and earlier Gator sandbox name validation. [#3082](https://github.com/NVIDIA/OpenShell/pull/3082), [#4534](https://github.com/NVIDIA/OpenShell/pull/4534), [#4660](https://github.com/NVIDIA/OpenShell/pull/4660)\n","reactions":{"url":"https://api.github.com/repos/NVIDIA/OpenShell/releases/418675856/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0}}