+#[test]
+fn user_tmpfs_options_and_sizes_are_encoded_in_hostconfig() {
+    let config: DockerSandboxDriverConfig = serde_json::from_value(serde_json::json!({
+        "mounts": [{
+            "type": "tmpfs",
+            "target": "/sandbox/cache",
+            "options": ["noexec", "nosuid"],
+            "size_bytes": 67_108_864,
+            "mode": 511
+        }]
+    }))
+    .unwrap();
+
+    let tmpfs = docker_driver_tmpfs_mounts(&config).unwrap();
+    assert_eq!(
+        tmpfs.get("/sandbox/cache").map(String::as_str),
+        Some("rw,size=67108864,mode=777,noexec,nosuid")
     );
 }
 
+#[test]
+fn user_tmpfs_defaults_to_docker_documented_mode() {
+    let config: DockerSandboxDriverConfig = serde_json::from_value(serde_json::json!({
+        "mounts": [{
+            "type": "tmpfs",
+            "target": "/sandbox/tmp",
+            "options": ["noexec", "nosuid"],
+            "size_bytes": 67_108_864
+        }]
+    }))
+    .unwrap();
+
+    let tmpfs = docker_driver_tmpfs_mounts(&config).unwrap();
+    assert_eq!(
+        tmpfs.get("/sandbox/tmp").map(String::as_str),
+        Some("rw,size=67108864,mode=1777,noexec,nosuid")
+    );
+}
+
+#[test]
+fn user_tmpfs_cannot_replace_or_mask_openshell_owned_tmpfs() {
+    let owned = HashMap::from([(
+        openshell_sandbox_backend::SUPERVISOR_CA_RUNTIME_DIR.to_string(),
+        "rw,noexec,nosuid".to_string(),
+    )]);
+    let user = HashMap::from([("/run/openshell-supervisor-ca".to_string(), "rw".to_string())]);
+
+    let error = merge_docker_driver_tmpfs_mounts(owned, user).unwrap_err();
+
+    assert!(error.message().contains("conflicts with an existing mount"));
+}
