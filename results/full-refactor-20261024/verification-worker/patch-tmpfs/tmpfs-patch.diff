+/// Encode user tmpfs mounts through Docker's HostConfig tmpfs map.
+///
+/// Some supported engines accept security flags through this API field while
+/// rejecting the same flags in the structured `Mount` tmpfs path.
+fn docker_driver_tmpfs_mounts(
+    config: &DockerSandboxDriverConfig,
+) -> Result<HashMap<String, String>, Status> {
+    config
+        .mounts
+        .iter()
+        .filter_map(|mount| match mount {
+            DockerDriverMountConfig::Tmpfs {
+                target,
+                options,
+                size_bytes,
+                mode,
+            } => Some((target, options, size_bytes, mode)),
+            _ => None,
+        })
+        .map(|(target, options, size_bytes, mode)| {
+            let mut encoded_options = Vec::new();
+            if !options
+                .iter()
+                .any(|option| matches!(option.trim(), "ro" | "rw"))
+            {
+                encoded_options.push("rw".to_string());
+            }
+            if let Some(size_bytes) =
+                validate_optional_positive_integral_i64(*size_bytes, "tmpfs size_bytes")?
+            {
+                encoded_options.push(format!("size={size_bytes}"));
+            }
+            let mode =
+                validate_optional_nonnegative_integral_i64(*mode, "tmpfs mode")?.unwrap_or(0o1777);
+            // The Docker tmpfs mount API documents 1777 as its default mode.
+            // Send it explicitly through HostConfig.tmpfs so engines that
+            // otherwise create a root-only mount preserve tmpfs semantics.
+            encoded_options.push(format!("mode={mode:o}"));
+            for option in options {
+                encoded_options.push(docker_tmpfs_option(option)?.join("="));
+            }
+            Ok((target.clone(), encoded_options.join(",")))
+        })
+        .collect()
+}
+
+fn merge_docker_driver_tmpfs_mounts(
+    mut existing: HashMap<String, String>,
+    additional: HashMap<String, String>,
+) -> Result<HashMap<String, String>, Status> {
+    for (target, options) in additional {
+        let normalized_target = driver_mounts::normalize_mount_target(&target);
+        for existing_target in existing.keys() {
+            if driver_mounts::paths_overlap(
+                Path::new(&normalized_target),
+                Path::new(existing_target),
+            ) {
+                return Err(Status::failed_precondition(format!(
+                    "docker tmpfs target conflicts with an existing mount: '{normalized_target}'"
+                )));
+            }
+        }
+        existing.insert(normalized_target, options);
+    }
+    Ok(existing)
+}
