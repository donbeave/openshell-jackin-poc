+        workspace_scope: Some(openshell_core::proto::workspace_selector("default")),
+        request_id: id(),
+        ..Default::default()
+    };
+
+    let first = run(&state, authed_request(request.clone())).await.unwrap();
+    let first_response = first.into_inner();
+    assert_eq!(first_response.sandbox_id, original_id);
+    state
+        .store
+        .delete(Sandbox::object_type(), &original_id)
+        .await
+        .unwrap();
+
+    let replacement = Sandbox {
+        metadata: Some(meta("immutable-replay")),
+        ..Default::default()
+    };
+    let replacement_id = replacement.object_id().to_string();
+    state.store.put_message(&replacement).await.unwrap();
+
+    let replay = run(&state, authed_request(request.clone())).await.unwrap();
+    assert_eq!(replay.metadata().get("openshell-replayed").unwrap(), "true");
+    let replayed = replay.into_inner();
+    assert_eq!(replayed.sandbox_id, original_id);
+    assert_eq!(replayed.outcome, first_response.outcome);
+    assert!(
+        state
+            .store
+            .get_message::<Sandbox>(&replacement_id)
+            .await
+            .unwrap()
+            .is_some()
+    );
+
+    let mut different_target = request.clone();
+    different_target.sandbox_id = replacement_id.clone();
+    let mismatch = run(&state, authed_request(different_target))
+        .await
+        .unwrap_err();
+    assert_eq!(reason(&mismatch), "REQUEST_ID_PAYLOAD_MISMATCH");
+    assert!(
+        state
+            .store
+            .get_message::<Sandbox>(&replacement_id)
+            .await
+            .unwrap()
+            .is_some()
+    );
+}
