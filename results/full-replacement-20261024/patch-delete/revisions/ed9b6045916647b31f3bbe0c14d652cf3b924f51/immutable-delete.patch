diff --git a/crates/openshell-sdk/tests/delete_by_id_integration.rs b/crates/openshell-sdk/tests/delete_by_id_integration.rs
new file mode 100644
index 00000000..d9717dc8
--- /dev/null
+++ b/crates/openshell-sdk/tests/delete_by_id_integration.rs
@@ -0,0 +1,317 @@
+use std::{
+    collections::HashMap,
+    env, fs,
+    time::{Duration, SystemTime, UNIX_EPOCH},
+};
+
+use openshell_sdk::{EdgeAuthInterceptor, OpenShellClient, raw::proto};
+use tonic::{
+    Code,
+    transport::{Certificate, ClientTlsConfig, Endpoint, Identity},
+};
+use uuid::Uuid;
+
+type TestResult<T> = Result<T, Box<dyn std::error::Error + Send + Sync>>;
+
+fn unique_name(prefix: &str) -> TestResult<String> {
+    let suffix = SystemTime::now().duration_since(UNIX_EPOCH)?.as_nanos() % 1_000_000_000_000_000;
+    Ok(format!("{prefix}{suffix:015}"))
+}
+
+fn request_id() -> String {
+    Uuid::new_v4().to_string()
+}
+
+async fn client() -> TestResult<OpenShellClient> {
+    let endpoint = env::var("PDEL_ENDPOINT")?;
+    let name = env::var("PDEL_SERVER_NAME").unwrap_or_else(|_| "localhost".into());
+    let ca = fs::read(env::var("PDEL_CA")?)?;
+    let cert = fs::read(env::var("PDEL_CLIENT_CERT")?)?;
+    let key = fs::read(env::var("PDEL_CLIENT_KEY")?)?;
+    let tls = ClientTlsConfig::new()
+        .ca_certificate(Certificate::from_pem(ca))
+        .domain_name(name)
+        .identity(Identity::from_pem(cert, key));
+    let channel = Endpoint::from_shared(endpoint)?
+        .connect_timeout(Duration::from_secs(5))
+        .timeout(Duration::from_secs(30))
+        .tls_config(tls)?
+        .connect()
+        .await?;
+    Ok(OpenShellClient::from_parts(
+        channel,
+        EdgeAuthInterceptor::noop(),
+    ))
+}
+
+async fn create(client: &OpenShellClient, name: &str) -> TestResult<String> {
+    let mut grpc = client.raw_grpc();
+    let response = grpc
+        .create_sandbox(proto::CreateSandboxRequest {
+            workspace_scope: Some(proto::workspace_selector("default")),
+            spec: Some(proto::SandboxSpec {
+                template: Some(proto::SandboxTemplate {
+                    image: env::var("PDEL_IMAGE").unwrap_or_else(|_| {
+                        "nvcr.io/nvidia/base/ubuntu@sha256:7e0f726d635d440d28a7f18e6498d3bdb76c7038bd4c90a090c21eb7c9f40686".into()
+                    }),
+                    ..Default::default()
+                }),
+                command: vec!["/bin/sh".into(), "-c".into(), "sleep 600".into()],
+                restart_policy: proto::SandboxRestartPolicy::Never as i32,
+                ..Default::default()
+            }),
+            name: name.into(),
+            labels: HashMap::from([("pdel.test-run".into(), name.into())]),
+            request_id: request_id(),
+            ..Default::default()
+        })
+        .await?
+        .into_inner();
+    let id = response
+        .sandbox
+        .and_then(|sandbox| sandbox.metadata)
+        .ok_or_else(|| std::io::Error::other("create response omitted sandbox metadata"))?
+        .id;
+    println!("owned_sandbox_id={id} test_label={name}");
+    Ok(id)
+}
+
+async fn cleanup_owned(
+    client: &OpenShellClient,
+    sandboxes: &[(String, String)],
+    workspace: Option<&str>,
+) -> TestResult<()> {
+    let mut grpc = client.raw_grpc();
+    for (name, id) in sandboxes {
+        match grpc
+            .delete_sandbox(proto::DeleteSandboxRequest {
+                workspace_scope: Some(proto::workspace_selector("default")),
+                request_id: request_id(),
+                sandbox_id: id.clone(),
+                ..Default::default()
+            })
+            .await
+        {
+            Ok(response) => {
+                let response_id = response.into_inner().sandbox_id;
+                if response_id == *id {
+                    client
+                        .wait_deleted(name, Duration::from_secs(60), Some(id))
+                        .await?;
+                }
+            }
+            Err(status) if status.code() == Code::NotFound => {}
+            Err(status) => return Err(Box::new(status)),
+        }
+    }
+    if let Some(workspace) = workspace {
+        grpc.delete_workspace(proto::DeleteWorkspaceRequest {
+            name: workspace.into(),
+            request_id: request_id(),
+            allow_missing: false,
+        })
+        .await?;
+    }
+    Ok(())
+}
+
+async fn cleanup_released_owned(
+    client: &OpenShellClient,
+    sandboxes: &[(String, String)],
+) -> TestResult<()> {
+    let mut grpc = client.raw_grpc();
+    for (name, id) in sandboxes {
+        let current = client.get_sandbox(name).await?;
+        if current.id != *id {
+            return Err(std::io::Error::other(format!(
+                "refusing released-server name cleanup: {name} now maps to {} instead of owned {id}",
+                current.id
+            ))
+            .into());
+        }
+        let response = grpc
+            .delete_sandbox(proto::DeleteSandboxRequest {
+                workspace_scope: Some(proto::workspace_selector("default")),
+                request_id: request_id(),
+                name: name.clone(),
+                ..Default::default()
+            })
+            .await?
+            .into_inner();
+        if response.sandbox_id != *id {
+            return Err(std::io::Error::other(format!(
+                "released-server name cleanup removed {} instead of owned {id}",
+                response.sandbox_id
+            ))
+            .into());
+        }
+        client
+            .wait_deleted(name, Duration::from_secs(60), Some(id))
+            .await?;
+    }
+    Ok(())
+}
+
+#[tokio::test]
+#[ignore = "requires v0.1.5 gateway and mTLS test credentials via PDEL_* environment"]
+async fn released_server_rejects_new_empty_name_id_delete_without_deleting() -> TestResult<()> {
+    let client = client().await?;
+    let name = unique_name("po")?;
+    let mut owned = Vec::new();
+    let result = async {
+        let id = create(&client, &name).await?;
+        owned.push((name.clone(), id.clone()));
+        client.wait_ready(&name, Duration::from_secs(120)).await?;
+
+        let mut grpc = client.raw_grpc();
+        let error = grpc
+            .delete_sandbox(proto::DeleteSandboxRequest {
+                name: String::new(),
+                sandbox_id: id.clone(),
+                request_id: request_id(),
+                workspace_scope: Some(proto::workspace_selector("default")),
+                allow_missing: false,
+            })
+            .await
+            .expect_err("released server must reject the unknown ID selector with empty name");
+        assert_eq!(error.code(), Code::InvalidArgument);
+        let still_there = client.get_sandbox(&name).await?;
+        assert_eq!(still_there.id, id);
+        println!("server=release-v0.1.5 request_sandbox_id={id}");
+        println!(
+            "observed_status={} original_still_present=true",
+            error.code()
+        );
+        Ok::<(), Box<dyn std::error::Error + Send + Sync>>(())
+    }
+    .await;
+    let cleanup = cleanup_released_owned(&client, &owned).await;
+    result?;
+    cleanup?;
+    Ok(())
+}
+
+#[tokio::test]
+#[ignore = "requires patched gateway and mTLS test credentials via PDEL_* environment"]
+async fn patched_server_replays_id_delete_after_removal_and_name_reuse() -> TestResult<()> {
+    let client = client().await?;
+    let name = unique_name("pn")?;
+    let other_workspace = unique_name("ws")?;
+    let mut owned = Vec::new();
+    let mut owned_workspace = None;
+    let result = async {
+        let mut grpc = client.raw_grpc();
+        grpc.create_workspace(proto::CreateWorkspaceRequest {
+            name: other_workspace.clone(),
+            request_id: request_id(),
+            ..Default::default()
+        })
+        .await?;
+        owned_workspace = Some(other_workspace.clone());
+
+        let original_id = create(&client, &name).await?;
+        owned.push((name.clone(), original_id.clone()));
+        client.wait_ready(&name, Duration::from_secs(120)).await?;
+        let original_request = proto::DeleteSandboxRequest {
+            workspace_scope: Some(proto::workspace_selector("default")),
+            request_id: request_id(),
+            sandbox_id: original_id.clone(),
+            ..Default::default()
+        };
+        let mut grpc = client.raw_grpc();
+        let deleted = grpc
+            .delete_sandbox(original_request.clone())
+            .await?
+            .into_inner();
+        assert_eq!(deleted.sandbox_id, original_id);
+        client
+            .wait_deleted(&name, Duration::from_secs(60), Some(&original_id))
+            .await?;
+
+        let replacement_id = create(&client, &name).await?;
+        owned.push((name.clone(), replacement_id.clone()));
+        client.wait_ready(&name, Duration::from_secs(120)).await?;
+        assert_ne!(replacement_id, original_id);
+
+        let replay = grpc.delete_sandbox(original_request.clone()).await?;
+        assert_eq!(replay.metadata().get("openshell-replayed").unwrap(), "true");
+        let replayed = replay.into_inner();
+        assert_eq!(replayed.sandbox_id, original_id);
+        assert_eq!(replayed.outcome, deleted.outcome);
+        let replacement = client.get_sandbox(&name).await?;
+        assert_eq!(replacement.id, replacement_id);
+
+        let mut different_target = original_request.clone();
+        different_target.sandbox_id = replacement_id.clone();
+        let mismatch = grpc
+            .delete_sandbox(different_target)
+            .await
+            .expect_err("one request ID with another sandbox ID must conflict");
+        assert_eq!(mismatch.code(), Code::FailedPrecondition);
+        assert!(mismatch.message().contains("REQUEST_ID_PAYLOAD_MISMATCH"));
+
+        let foreign = grpc
+            .delete_sandbox(proto::DeleteSandboxRequest {
+                request_id: request_id(),
+                sandbox_id: replacement_id.clone(),
+                workspace_scope: Some(proto::workspace_selector(other_workspace.clone())),
+                ..Default::default()
+            })
+            .await
+            .expect_err("foreign workspace target must be hidden");
+        let absent = grpc
+            .delete_sandbox(proto::DeleteSandboxRequest {
+                request_id: request_id(),
+                sandbox_id: "sandbox-never-created".into(),
+                workspace_scope: Some(proto::workspace_selector(other_workspace.clone())),
+                ..Default::default()
+            })
+            .await
+            .expect_err("absent target must not be acknowledged as deleted");
+        assert_eq!(foreign.code(), Code::NotFound);
+        assert_eq!(absent.code(), foreign.code());
+
+        let foreign_allow_missing = grpc
+            .delete_sandbox(proto::DeleteSandboxRequest {
+                request_id: request_id(),
+                sandbox_id: replacement_id.clone(),
+                workspace_scope: Some(proto::workspace_selector(other_workspace.clone())),
+                allow_missing: true,
+                ..Default::default()
+            })
+            .await
+            .expect_err("ID mode must reject allow_missing before target lookup");
+        let absent_allow_missing = grpc
+            .delete_sandbox(proto::DeleteSandboxRequest {
+                request_id: request_id(),
+                sandbox_id: "sandbox-never-created".into(),
+                workspace_scope: Some(proto::workspace_selector(other_workspace.clone())),
+                allow_missing: true,
+                ..Default::default()
+            })
+            .await
+            .expect_err("ID mode must reject allow_missing before target lookup");
+        assert_eq!(foreign_allow_missing.code(), Code::InvalidArgument);
+        assert_eq!(absent_allow_missing.code(), foreign_allow_missing.code());
+
+        let still_there = client.get_sandbox(&name).await?;
+        assert_eq!(still_there.id, replacement_id);
+        println!("original_id={original_id}");
+        println!("replacement_id={replacement_id}");
+        println!("delete_outcome={:?}", deleted.outcome);
+        println!("same_request_replayed=true");
+        println!("same_request_different_id_status={}", mismatch.code());
+        println!("foreign_and_absent_status={}", foreign.code());
+        println!(
+            "allow_missing_foreign_and_absent_status={}",
+            foreign_allow_missing.code()
+        );
+        println!("replacement_survived=true");
+        Ok::<(), Box<dyn std::error::Error + Send + Sync>>(())
+    }
+    .await;
+    let cleanup = cleanup_owned(&client, &owned, owned_workspace.as_deref()).await;
+    result?;
+    cleanup?;
+    Ok(())
+}
