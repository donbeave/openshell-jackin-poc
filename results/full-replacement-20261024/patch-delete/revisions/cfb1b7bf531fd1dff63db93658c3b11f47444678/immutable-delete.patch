+++ b/crates/openshell-sdk/tests/delete_by_id_integration.rs
@@ -0,0 +1,244 @@
+use std::{
+    env, fs,
+    time::{Duration, SystemTime, UNIX_EPOCH},
+};
+
+use openshell_sdk::{DeleteOptions, EdgeAuthInterceptor, OpenShellClient, raw::proto};
+use tonic::{
+    Code,
+    transport::{Certificate, ClientTlsConfig, Endpoint, Identity},
+};
+
+type TestResult<T> = Result<T, Box<dyn std::error::Error + Send + Sync>>;
+
+fn unique_name(prefix: &str) -> TestResult<String> {
+    let suffix = SystemTime::now().duration_since(UNIX_EPOCH)?.as_nanos() % 1_000_000_000_000_000;
+    Ok(format!("{prefix}{suffix:015}"))
+}
+
+async fn client() -> TestResult<OpenShellClient> {
+    let endpoint = env::var("PDEL_ENDPOINT")?;
+    let name = env::var("PDEL_SERVER_NAME").unwrap_or_else(|_| "localhost".into());
+    let ca = fs::read(env::var("PDEL_CA")?)?;
+    let cert = fs::read(env::var("PDEL_CLIENT_CERT")?)?;
+    let key = fs::read(env::var("PDEL_CLIENT_KEY")?)?;
+    let tls = ClientTlsConfig::new()
+        .ca_certificate(Certificate::from_pem(ca))
+        .domain_name(name)
+        .identity(Identity::from_pem(cert, key));
+    let channel = Endpoint::from_shared(endpoint)?
+        .connect_timeout(Duration::from_secs(5))
+        .timeout(Duration::from_secs(30))
+        .tls_config(tls)?
+        .connect()
+        .await?;
+    Ok(OpenShellClient::from_parts(
+        channel,
+        EdgeAuthInterceptor::noop(),
+    ))
+}
+
+async fn create(client: &OpenShellClient, name: &str) -> TestResult<String> {
+    let mut grpc = client.raw_grpc();
+    let response = grpc
+        .create_sandbox(proto::CreateSandboxRequest {
+            workspace_scope: Some(proto::workspace_selector("default")),
+            spec: Some(proto::SandboxSpec {
+                template: Some(proto::SandboxTemplate {
+                    image: env::var("PDEL_IMAGE").unwrap_or_else(|_| "ubuntu:22.04".into()),
+                    ..Default::default()
+                }),
+                command: vec!["/bin/sh".into(), "-c".into(), "sleep 600".into()],
+                restart_policy: proto::SandboxRestartPolicy::Never as i32,
+                ..Default::default()
+            }),
+            name: name.into(),
+            request_id: String::new(),
+            ..Default::default()
+        })
+        .await?
+        .into_inner();
+    let id = response
+        .sandbox
+        .and_then(|sandbox| sandbox.metadata)
+        .ok_or_else(|| std::io::Error::other("create response omitted sandbox metadata"))?
+        .id;
+    client.wait_ready(name, Duration::from_secs(120)).await?;
+    Ok(id)
+}
+
+async fn cleanup_prefix(client: &OpenShellClient, prefix: &str) -> TestResult<()> {
+    for sandbox in client.list_all_sandboxes(Default::default()).await? {
+        if sandbox.name.starts_with(prefix) {
+            let result = client
+                .delete_sandbox_by_id(&sandbox.id, DeleteOptions::default())
+                .await?;
+            client
+                .wait_deleted(
+                    &sandbox.name,
+                    Duration::from_secs(60),
+                    result.sandbox_id.as_deref(),
+                )
+                .await?;
+        }
+    }
+    Ok(())
+}
+
+#[tokio::test]
+#[ignore = "requires v0.1.5 gateway and mTLS test credentials via PDEL_* environment"]
+async fn released_server_rejects_new_empty_name_id_delete_without_deleting() -> TestResult<()> {
+    let client = client().await?;
+    cleanup_prefix(&client, "po").await?;
+    let name = unique_name("po")?;
+    let id = create(&client, &name).await?;
+    let mut grpc = client.raw_grpc();
+    let error = grpc
+        .delete_sandbox(proto::DeleteSandboxRequest {
+            name: String::new(),
+            sandbox_id: id.clone(),
+            workspace_scope: Some(proto::workspace_selector("default")),
+            allow_missing: false,
+            ..Default::default()
+        })
+        .await
+        .expect_err("released server must reject the unknown ID selector with empty name");
+    assert!(
+        error.code() == Code::InvalidArgument,
+        "expected InvalidArgument, got {error}"
+    );
+    let still_there = client.get_sandbox(&name).await?;
+    assert!(
+        still_there.id == id,
+        "released server deleted or retargeted the sandbox"
+    );
+    println!("server=release-v0.1.5 request_sandbox_id={id}");
+    println!(
+        "observed_status={} original_still_present=true",
+        error.code()
+    );
+    let cleanup = client
+        .delete_sandbox(&name, DeleteOptions::default())
+        .await?;
+    assert!(cleanup.sandbox_id.as_deref() == Some(id.as_str()));
+    client
+        .wait_deleted(&name, Duration::from_secs(60), Some(&id))
+        .await?;
+    Ok(())
+}
+
+#[tokio::test]
+#[ignore = "requires patched gateway and mTLS test credentials via PDEL_* environment"]
+async fn patched_server_deletes_by_id_and_preserves_name_replacement() -> TestResult<()> {
+    let client = client().await?;
+    cleanup_prefix(&client, "pn").await?;
+    let name = unique_name("pn")?;
+    let original_id = create(&client, &name).await?;
+    let deleted = client
+        .delete_sandbox_by_id(&original_id, DeleteOptions::default())
+        .await?;
+    assert!(deleted.sandbox_id.as_deref() == Some(original_id.as_str()));
+    client
+        .wait_deleted(&name, Duration::from_secs(60), Some(&original_id))
+        .await?;
+
+    let replacement_id = create(&client, &name).await?;
+    assert!(replacement_id != original_id);
+
+    let stale = client
+        .delete_sandbox_by_id(
+            &original_id,
+            DeleteOptions {
+                allow_missing: true,
+            },
+        )
+        .await?;
+    assert!(stale.sandbox_id.as_deref() == Some(original_id.as_str()));
+    assert!(stale.outcome == openshell_sdk::DeletionOutcome::AlreadyAbsent);
+    let replacement = client.get_sandbox(&name).await?;
+    assert!(
+        replacement.id == replacement_id,
+        "stale immutable-ID delete affected replacement"
+    );
+
+    let mut grpc = client.raw_grpc();
+    let other_workspace = unique_name("ws")?;
+    let workspace_created = grpc
+        .create_workspace(proto::CreateWorkspaceRequest {
+            name: other_workspace.clone(),
+            ..Default::default()
+        })
+        .await;
+    let (selected_workspace, workspace_creation_evidence) = match workspace_created {
+        Ok(_) => (
+            other_workspace.clone(),
+            "created via CreateWorkspace API".to_string(),
+        ),
+        Err(error) => {
+            println!("valid_other_workspace_creation_status={}", error.code());
+            (
+                "pdel-nonexistent-workspace".to_string(),
+                "BLOCKED: authenticated test operator cannot create another workspace".to_string(),
+            )
+        }
+    };
+    let cross_workspace = grpc
+        .delete_sandbox(proto::DeleteSandboxRequest {
+            sandbox_id: replacement_id.clone(),
+            workspace_scope: Some(proto::workspace_selector(selected_workspace)),
+            ..Default::default()
+        })
+        .await
+        .expect_err("wrong workspace must not delete the selected target");
+    let wrong_workspace_code = cross_workspace.code();
+    let dual_selector = grpc
+        .delete_sandbox(proto::DeleteSandboxRequest {
+            sandbox_id: replacement_id.clone(),
+            name: name.clone(),
+            workspace_scope: Some(proto::workspace_selector("default")),
+            ..Default::default()
+        })
+        .await
+        .expect_err("both selectors must be rejected");
+    let dual_selector_code = dual_selector.code();
+    let still_there = client.get_sandbox(&name).await?;
+    let replacement_survived_negative_requests = still_there.id == replacement_id;
+
+    let cleanup = client
+        .delete_sandbox_by_id(&replacement_id, DeleteOptions::default())
+        .await?;
+    assert!(cleanup.sandbox_id.as_deref() == Some(replacement_id.as_str()));
+    client
+        .wait_deleted(&name, Duration::from_secs(60), Some(&replacement_id))
+        .await?;
+    if workspace_creation_evidence == "created via CreateWorkspace API" {
+        grpc.delete_workspace(proto::DeleteWorkspaceRequest {
+            name: other_workspace,
+            ..Default::default()
+        })
+        .await?;
+    }
+    println!("wrong_workspace_status={wrong_workspace_code}");
+    println!("dual_selector_status={dual_selector_code}");
+    println!("other_workspace={workspace_creation_evidence}");
+    assert!(
+        matches!(
+            wrong_workspace_code,
+            Code::NotFound | Code::PermissionDenied | Code::InvalidArgument
+        ),
+        "wrong workspace was not denied: {wrong_workspace_code}"
+    );
+    assert!(dual_selector_code == Code::InvalidArgument);
+    assert!(
+        replacement_survived_negative_requests,
+        "negative request deleted replacement"
+    );
+    println!("original_id={original_id}");
+    println!("replacement_id={replacement_id}");
+    println!("first_delete_outcome={:?}", deleted.outcome);
+    println!("stale_delete_outcome={:?}", stale.outcome);
+    println!("wrong_workspace_status={wrong_workspace_code}");
+    println!("dual_selector_status={dual_selector_code}");
+    println!("replacement_survived=true");
+    Ok(())
+}
